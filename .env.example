# Supabase — Settings > API no painel do projeto
# Usadas apenas no backend (server actions). Nunca expostas ao navegador.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI — usado no pipeline de IA (extração de lançamentos e insights)
OPENAI_API_KEY=

# dashboard-psi — fonte do salário variável (Valor Recebido). Somente leitura, só no backend.
# Supabase do projeto dashboard-psi (Settings > API). Opcional: sem isso, vale o valor digitado.
PSI_SUPABASE_URL=
PSI_SUPABASE_SERVICE_KEY=
